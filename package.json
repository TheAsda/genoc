{
  "name": "genoc",
  "version": "0.4.0",
  "description": "Generate typed HTTP clients from OpenAPI 3.0 / 3.1 specifications",
  "keywords": [
    "client",
    "generator",
    "http",
    "openapi",
    "typescript"
  ],
  "license": "MIT",
  "author": "Andrey Kiselev",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheAsda/genoc"
  },
  "bin": {
    "genoc": "./dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./runtime": {
      "import": "./dist/runtime/index.js",
      "types": "./dist/runtime/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "changeset": "changeset",
    "version-packages": "changeset version && oxfmt --write",
    "release": "bun run build && changeset publish"
  },
  "dependencies": {
    "@stricli/core": "^1.2.6",
    "lilconfig": "^3.1.3",
    "yaml": "^2.2.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.2",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "typescript": "^6.0.3",
    "undici": "^8",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "undici": "^6.13.0 || ^7 || ^8"
  },
  "peerDependenciesMeta": {
    "undici": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.18.1"
  }
}
