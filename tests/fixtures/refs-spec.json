      "CircularA": { "$ref": "#/components/schemas/CircularB" },
      "CircularB": { "$ref": "#/components/schemas/CircularA" },
      "ChainA": { "$ref": "#/components/schemas/ChainB" },
      "ChainB": { "$ref": "#/components/schemas/ChainC" },
      "ChainC": { "type": "string" },
      "EscapedPath": {
        "$ref": "#/paths/~1users/get"
      },
      "ExternalRef": {
        "$ref": "https://example.com/schemas/model.json"
