          "address": { "$ref": "#/components/schemas/Address" }
        }
      },
      "Address": {
        "type": "object",
        "properties": {
          "city": { "type": "string" },
          "country": { "$ref": "#/components/schemas/Country" }
        }
      },
      "Country": {
        "type": "object",
        "properties": {
          "name": { "type": "string" }
        }
