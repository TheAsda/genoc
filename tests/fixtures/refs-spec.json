      "Depth1": { "$ref": "#/components/schemas/Depth2" },
      "Depth2": { "$ref": "#/components/schemas/Depth3" },
      "Depth3": { "$ref": "#/components/schemas/Depth4" },
      "Depth4": { "$ref": "#/components/schemas/Depth5" },
      "Depth5": { "$ref": "#/components/schemas/Depth6" },
      "Depth6": { "$ref": "#/components/schemas/Depth7" },
      "Depth7": { "$ref": "#/components/schemas/Depth8" },
      "Depth8": { "$ref": "#/components/schemas/Depth9" },
      "Depth9": { "$ref": "#/components/schemas/Depth10" },
      "Depth10": { "$ref": "#/components/schemas/Depth11" },
      "Depth11": { "type": "boolean" }
    }
  }
}
