{
  "openapi": "3.0.3",
  "info": { "title": "Concrete discriminator base — Entity family", "version": "1.0.0" },
  "paths": {
    "/api/Entities/Find": {
      "get": {
        "parameters": [
          { "name": "take", "in": "query", "schema": { "type": "integer" } },
          { "name": "skip", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Entity" } }
              }
            }
          }
        }
      }
    },
    "/api/Entities/{entityId}": {
      "get": {
        "parameters": [
          {
            "name": "entityId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EntityDetails" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Entity": {
        "type": "object",
        "required": ["$type", "id", "name"],
        "properties": {
          "$type": { "type": "string" },
          "id": { "type": "string" },
          "name": { "type": "string" }
        },
        "discriminator": {
          "propertyName": "$type",
          "mapping": {
            "EntityDetails": "#/components/schemas/EntityDetails"
          }
        }
      },
      "EntityDetails": {
        "allOf": [
          { "$ref": "#/components/schemas/Entity" },
          {
            "type": "object",
            "required": ["shortName"],
            "properties": { "shortName": { "type": "string" } }
          }
        ]
      }
    }
  }
}
