    postUpload: decorateWithErrors<(body?: PostUploadBody) => Promise<PostUploadResponse>, PostUploadErrors>(
      async (body?: PostUploadBody): Promise<PostUploadResponse> => {
        if (body) {
          const formData = new FormData();
          if (body.text_field !== undefined) formData.append("text_field", body.text_field);
          formData.append("file_field", body.file_field.data, body.file_field.filename);
          if (body.text_file !== undefined) formData.append("text_file", body.text_file);
          if (body.array_field !== undefined) formData.append("array_field", body.array_field);
          if (body.gallery !== undefined) { for (const file of body.gallery) { formData.append("gallery", file.data, file.filename); } }
          try {
            const result = await requester<PostUploadResponse>("POST", \`/upload\`, { body: formData });
            if (result instanceof ErrorResponse) {
              if (result.status === 400) throw new ApiError(400, result.data as PostUploadError400, result.message ?? \`Request failed with status 400\`);
              throw new UnspecifiedApiError(result.status, result.data, result.message ?? \`Request failed with status \${result.status}\`);
            }
            if (result instanceof StreamResponse) {
              throw new RequesterFailError(new Error("Unexpected stream response"));
            }
            return result;
          } catch (error) {
            if (error instanceof UnspecifiedApiError) throw error;
            if (error instanceof ApiError) throw error;
            throw new RequesterFailError(error);
          }
        }
        try {
          const result = await requester<PostUploadResponse>("POST", \`/upload\`, {});
          if (result instanceof ErrorResponse) {
            if (result.status === 400) throw new ApiError(400, result.data as PostUploadError400, result.message ?? \`Request failed with status 400\`);
