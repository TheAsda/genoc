exports[`Format branding in generated contracts > additionalProperties with format use branded type 1`] = `
"// Auto-generated by genoc from OpenAPI 3.0.0 spec. DO NOT EDIT.

import { ApiError, StreamResponse } from 'genoc/runtime';
export {
  ApiError,
  UnspecifiedApiError,
  DefaultApiError,
  RequesterFailError,
  StreamResponse,
  ErrorResponse,
} from 'genoc/runtime';

export type DateTimeString = string & { readonly __format?: 'date-time' };
export type Int32Number = number & { readonly __format?: 'int32' };
export type DoubleNumber = number & { readonly __format?: 'double' };
export type EmailString = string & { readonly __format?: 'email' };
export type MyCustomFormatString = string & { readonly __format?: 'my-custom-format' };

export type DateString = DateTimeString;

export type UuidString = string;

export type IntId = Int32Number;

export type Score = DoubleNumber;

export type Email = EmailString;

export type BinaryData = string;

export type ByteData = string;

export type EmptyFormat = string;

export type CustomFormat = MyCustomFormatString;

export type NullableDate = DateTimeString | null;

export type Item = {
  id: string;
  createdAt: DateTimeString;
  email: EmailString;
  score?: DoubleNumber;
};

export type GetItemsResponse = Array<{
  id: string;
  createdAt: DateTimeString;
}>;

export type PostItemsBody = {
  email: 'user@example.com' | 'test@example.org';
};

export type PostItemsResponse = Item;

export type GetRecordsResponse = Record<string, DateTimeString>;"
`;

