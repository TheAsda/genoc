exports[`Format branding in generated contracts > additionalProperties with format use branded type 1`] = `
"// Auto-generated by genoc from OpenAPI 3.0.0 spec. DO NOT EDIT.

export type DateTimeString = string & { readonly __format?: 'date-time' };
export type Int32Number = number & { readonly __format?: 'int32' };
export type DoubleNumber = number & { readonly __format?: 'double' };
export type EmailString = string & { readonly __format?: 'email' };
export type MyCustomFormatString = string & { readonly __format?: 'my-custom-format' };

export type DateString = DateTimeString;

export type UuidString = string;

export type IntId = Int32Number;

export type Score = DoubleNumber;

export type Email = EmailString;

export type BinaryData = string;

export type ByteData = string;

export type EmptyFormat = string;

export type CustomFormat = MyCustomFormatString;

export type NullableDate = DateTimeString | null;

export type Item = { id: string; createdAt: DateTimeString; email: EmailString; score?: DoubleNumber; };

export type GetItemsResponse = Array<{ id: string; createdAt: DateTimeString; }>;

export type PostItemsBody = { email: 'user@example.com' | 'test@example.org'; };

export type PostItemsResponse = Item;

export type GetRecordsResponse = Record<string, DateTimeString>;

export class StreamResponse {
  constructor(
    public readonly data: ReadableStream<Uint8Array>,
    public readonly filename?: string,
    public readonly headers: Record<string, string> = {},
  ) {}
}

export function streamResponse(
  data: ReadableStream<Uint8Array>,
  filename?: string,
  headers?: Record<string, string>,
): StreamResponse {
  return new StreamResponse(data, filename, headers ?? {});
}

export class ErrorResponse {
  constructor(
    public readonly status: number,
    public readonly data: unknown,
    public readonly headers: Record<string, string>,
    public readonly message?: string,
  ) {}
}

export function errorResponse(
  status: number,
  data: unknown,
  headers?: Record<string, string>,
  message?: string,
): ErrorResponse {
  return new ErrorResponse(status, data, headers ?? {}, message);
}

export class RequesterFailError extends Error {
  constructor(
    public readonly cause: unknown,
  ) {
    super(\`Request failed: \${cause instanceof Error ? cause.message : String(cause)}\`);
    this.name = "RequesterFailError";
  }
}

export class ApiError<TStatus extends number, TData> extends Error {
  constructor(
    public readonly status: TStatus,
    public readonly data: TData,
    message: string,
  ) {
    super(message);
    this.name = "ApiError";
  }
}

export class UnspecifiedApiError extends ApiError<number, unknown> {
  constructor(
    status: number,
    data: unknown,
    message: string,
  ) {
    super(status, data, message);
    this.name = "UnspecifiedApiError";
  }
}"
`;

