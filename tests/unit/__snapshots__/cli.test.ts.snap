exports[`CLI Entry Point > shows help when --help flag is used 1`] = `
"USAGE
  genoc (--output-dir dir) [--method-name-strategy path-based|operationId|operationId-with-fallback] [--spec-version version] [--strict-version] <spec>
  genoc --help
  genoc --version

Generate typed TypeScript HTTP clients from OpenAPI 3.0 / 3.1 specs (JSON/YAML, file or URL).

FLAGS
      --output-dir                           Directory to write generated files
     [--method-name-strategy]                Method naming strategy                                     [path-based|operationId|operationId-with-fallback, default = path-based]
     [--spec-version]                        Override auto-detected OpenAPI version (e.g. "3.0", "3.1")
     [--strict-version/--no-strict-version]  Enable strict version checking                             [default = true]
  -h  --help                                 Print help information and exit
  -v  --version                              Print version information and exit

ARGUMENTS
  spec  Path or URL to OpenAPI 3.0 or 3.1 spec (JSON/YAML)
"
`;

exports[`CLI Entry Point > shows version when --version flag is used 1`] = `
